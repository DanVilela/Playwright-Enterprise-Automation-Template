# Environment Variables Template
# Copy this file to .env and fill in the actual values
# Never commit .env with real credentials to the repository

# Xray Cloud Credentials
# Get these from your Xray Cloud account settings
XRAY_CLIENT_ID=your_client_id_here
XRAY_CLIENT_SECRET=your_client_secret_here

# Application URL (defaults to saucedemo.com)
BASE_URL=https://www.saucedemo.com

# Node Environment
NODE_ENV=test
